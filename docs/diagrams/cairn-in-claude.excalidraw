    { "type": "text", "id": "guard_note", "x": 60, "y": 662, "width": 1200, "height": 40, "text": "the security shape: credentials live only in the server process's env vars — cairn.json refuses to hold secrets,\nand every mutation is a typed tool call Claude Code can permission-gate.", "originalText": "the security shape: credentials live only in the server process's env vars — cairn.json refuses to hold secrets,\nand every mutation is a typed tool call Claude Code can permission-gate.", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#4a5b6b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 700045, "version": 1, "versionNonce": 700046, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
