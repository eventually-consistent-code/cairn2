    { "type": "text", "id": "t_new", "x": 96, "y": 468, "width": 200, "height": 66, "text": "epic per phase\nissue per requirement\nestimates populated", "originalText": "epic per phase\nissue per requirement\nestimates populated", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 500013, "version": 1, "versionNonce": 500014, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.3 },
