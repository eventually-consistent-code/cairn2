    { "type": "text", "id": "ev_box_t", "x": 120, "y": 748, "width": 660, "height": 122, "text": "[claim]  starting: adding Linear as the eighth tracker backend...   → in_progress\n[note]   contract suite green — 29 new tests, capability matrix honest\n[close]  shipped: eighth backend, native issue links. PR #23.\n         time spent: ~35m  → logged as a real Jira worklog", "originalText": "[claim]  starting: adding Linear as the eighth tracker backend...   → in_progress\n[note]   contract suite green — 29 new tests, capability matrix honest\n[close]  shipped: eighth backend, native issue links. PR #23.\n         time spent: ~35m  → logged as a real Jira worklog", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 500037, "version": 1, "versionNonce": 500038, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "ev_box", "lineHeight": 1.5 },

    { "type": "ellipse", "id": "cloud1", "x": 840, "y": 700, "width": 460, "height": 118, "strokeColor": "#6d28d9", "backgroundColor": "#ddd6fe", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 500039, "version": 1, "versionNonce": 500040, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false },
    { "type": "text", "id": "cloud_t", "x": 900, "y": 732, "width": 340, "height": 48, "text": "off the spine, any time: trace · probe ·\ndraft · thread — sessions that survive\n/clear, each mirrored as an issue", "originalText": "off the spine, any time: trace · probe ·\ndraft · thread — sessions that survive\n/clear, each mirrored as an issue", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 500043, "version": 1, "versionNonce": 500044, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.3 },
    { "type": "text", "id": "mem_loop", "x": 890, "y": 828, "width": 420, "height": 48, "text": "memory loop: retro → cards (with provenance) →\nrecall (staleness-flagged) → the next plan starts smarter", "originalText": "memory loop: retro → cards (with provenance) →\nrecall (staleness-flagged) → the next plan starts smarter", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 500045, "version": 1, "versionNonce": 500046, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.3 }
