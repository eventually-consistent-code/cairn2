    { "type": "text", "id": "g_new", "x": 96, "y": 250, "width": 190, "height": 80, "text": "interview →\nPROJECT.md\nroadmap.md\nphase dirs", "originalText": "interview →\nPROJECT.md\nroadmap.md\nphase dirs", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400047, "version": 1, "versionNonce": 400048, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.3 },
    { "type": "text", "id": "g_plan", "x": 316, "y": 250, "width": 200, "height": 80, "text": "research (depth dial)\nRESEARCH.md\nPLAN.md + waves\nCONTEXT.md wins", "originalText": "research (depth dial)\nRESEARCH.md\nPLAN.md + waves\nCONTEXT.md wins", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400049, "version": 1, "versionNonce": 400050, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.3 },
    { "type": "text", "id": "g_work", "x": 536, "y": 250, "width": 200, "height": 80, "text": "commits land\nLEDGER.md appends\nsha ↔ issue links", "originalText": "commits land\nLEDGER.md appends\nsha ↔ issue links", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400051, "version": 1, "versionNonce": 400052, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.3 },
    { "type": "text", "id": "g_verify", "x": 756, "y": 250, "width": 210, "height": 80, "text": "goal-backward check\nVERIFICATION.md\nnot task-forward", "originalText": "goal-backward check\nVERIFICATION.md\nnot task-forward", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400053, "version": 1, "versionNonce": 400054, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.3 },
    { "type": "text", "id": "g_ship", "x": 976, "y": 250, "width": 190, "height": 80, "text": "gate: drift clean\n+ no open issues\nthen push", "originalText": "gate: drift clean\n+ no open issues\nthen push", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400055, "version": 1, "versionNonce": 400056, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.3 },
