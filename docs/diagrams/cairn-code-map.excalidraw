    { "type": "text", "id": "core_strip", "x": 60, "y": 748, "width": 1300, "height": 20, "text": "shared core: config.ts (secret-refusing loader) · http.ts (retry, backoff, pagination) · continuity.ts (session handoff) · errors.ts (AUTH_MISSING, RATE_LIMITED, NOT_FOUND, UNSUPPORTED)", "originalText": "shared core: config.ts (secret-refusing loader) · http.ts (retry, backoff, pagination) · continuity.ts (session handoff) · errors.ts (AUTH_MISSING, RATE_LIMITED, NOT_FOUND, UNSUPPORTED)", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#4a5b6b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300045, "version": 1, "versionNonce": 300046, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },

    { "type": "text", "id": "ev_label", "x": 60, "y": 800, "width": 500, "height": 20, "text": "the contract every backend implements (types.ts):", "originalText": "the contract every backend implements (types.ts):", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#16324f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300047, "version": 1, "versionNonce": 300048, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "rectangle", "id": "ev_code", "x": 60, "y": 828, "width": 700, "height": 200, "strokeColor": "#14304b", "backgroundColor": "#14304b", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300049, "version": 1, "versionNonce": 300050, "isDeleted": false, "groupIds": [], "boundElements": [{ "id": "ev_code_t", "type": "text" }], "link": null, "locked": false, "roundness": { "type": 3 } },
    { "type": "text", "id": "ev_code_t", "x": 80, "y": 842, "width": 660, "height": 172, "text": "interface Tracker {\n  capabilities: Capability   // 9 honest flags, no pretending\n  createIssue / getIssue / updateIssue / closeIssue / listIssues\n  createPhase / listPhases / closePhase\n  createMilestone / listMilestones / completeMilestone\n  commentIssue · logWork? · resolveSelf?\n  linkIssues? / unlinkIssues? / listLinks?   // dependency graph\n  listComments? / listWorklogs?              // migration reads\n}", "originalText": "interface Tracker {\n  capabilities: Capability   // 9 honest flags, no pretending\n  createIssue / getIssue / updateIssue / closeIssue / listIssues\n  createPhase / listPhases / closePhase\n  createMilestone / listMilestones / completeMilestone\n  commentIssue · logWork? · resolveSelf?\n  linkIssues? / unlinkIssues? / listLinks?   // dependency graph\n  listComments? / listWorklogs?              // migration reads\n}", "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#35c9a6", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300051, "version": 1, "versionNonce": 300052, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": "ev_code", "lineHeight": 1.4 },
    { "type": "text", "id": "summary_flow", "x": 810, "y": 840, "width": 560, "height": 130, "text": "summary flow:\n\nverb .md  →  MCP tool  →  SPI  →  adapter  →  your tracker\n\none contract, eight backends — every verb works on all of\nthem unchanged. capability flags degrade gracefully instead\nof pretending.", "originalText": "summary flow:\n\nverb .md  →  MCP tool  →  SPI  →  adapter  →  your tracker\n\none contract, eight backends — every verb works on all of\nthem unchanged. capability flags degrade gracefully instead\nof pretending.", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#16324f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 300053, "version": 1, "versionNonce": 300054, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.4 }
  ]
